---
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import { siteConfig } from '../config/site';
import LiveCmsPage from './cms/LiveCmsPage';
import { pageKeyFromPath } from '../lib/cms/schema';
import { getChromeSnapshot, getPublicMediaUrl, getPublishedPageSnapshot, getPublicCollectionsSnapshot } from '../lib/supabase/snapshot';
import '@phosphor-icons/web/regular';
import '../styles/global.css';
import '../styles/cms.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = siteConfig.title,
  description = siteConfig.description,
} = Astro.props;
const pageKey = pageKeyFromPath(Astro.url.pathname);
const [cmsPage, chrome] = await Promise.all([pageKey ? getPublishedPageSnapshot(pageKey) : null, getChromeSnapshot()]);
const collections = cmsPage ? await getPublicCollectionsSnapshot() : { news: [], calendar: [], documents: [] };
const siteName = chrome?.settings?.site_name || 'Smedby 1:6';
const effectiveTitle = cmsPage?.seo_title || (cmsPage ? `${cmsPage.title} | ${siteName}` : chrome?.settings?.default_seo_title || title);
const effectiveDescription = cmsPage?.seo_description || chrome?.settings?.default_seo_description || description;
let socialMediaUrl = chrome?.socialMediaUrl ?? null;
if (cmsPage?.social_media_id && cmsPage.social_media_id !== chrome?.settings?.social_media_id) {
  socialMediaUrl = await getPublicMediaUrl(cmsPage.social_media_id);
}
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={effectiveDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={effectiveTitle} />
    <meta property="og:description" content={effectiveDescription} />
    <meta property="og:type" content="website" />
    {socialMediaUrl && <meta property="og:image" content={socialMediaUrl} />}
    <title>{effectiveTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehåll</a>
    <Navigation currentPath={Astro.url.pathname} />
    <main id="main">
      {pageKey && <LiveCmsPage pageKey={pageKey} initialPage={cmsPage} initialCollections={collections} client:load />}
      <div class:list={['static-page', cmsPage && 'is-cms-replaced']} data-static-page>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
