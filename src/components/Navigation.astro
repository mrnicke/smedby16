---
import { navigationItems } from '../data/navigation';
import { siteConfig } from '../config/site';
import { getChromeSnapshot } from '../lib/supabase/snapshot';
import CmsNavigation from './cms/CmsNavigation';
type Props={currentPath:string};
const{currentPath}=Astro.props;
const snapshot=await getChromeSnapshot();
const items=snapshot?.navigation??navigationItems.map((item,index)=>({...item,id:`fallback-${index}`}));
const siteName=snapshot?.settings?.site_name??siteConfig.name;
---
<CmsNavigation initialItems={items} currentPath={currentPath} siteName={siteName} client:load />
