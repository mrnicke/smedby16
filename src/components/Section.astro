---
type Props = {
  id?: string;
  title?: string;
  intro?: string;
  variant?: 'default' | 'muted' | 'accent';
};

const { id, title, intro, variant = 'default' } = Astro.props;
---

<section id={id} class:list={['section', `section-${variant}`]}>
  <div class="container">
    {
      (title || intro) && (
        <div class="section-heading">
          {title && <h2>{title}</h2>}
          {intro && <p>{intro}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
