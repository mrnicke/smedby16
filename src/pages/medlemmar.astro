---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Notice from '../components/Notice.astro';
---

<Layout
  title="Medlemmar | Smedby 1:6"
  description="Information om kommande medlemssidor för Smedby 1:6."
>
  <PageHeader
    eyebrow="Medlemmar"
    title="Medlemmar"
    intro="Medlemssidor kommer i ett senare steg."
  />

  <Section>
    <Notice title="Ingen inloggning i fas 1" tone="info">
      <p>
        Dokument, protokoll och medlemsinformation kan bli tillgängligt här senare. Den första versionen innehåller ingen inloggning och ingen medlemshantering.
      </p>
    </Notice>
  </Section>
</Layout>
